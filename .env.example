# Copy to .env and fill in real values. Never commit .env.

# LLM — any OpenAI-compatible endpoint. Development uses NVIDIA NIM.
# Get a key at https://build.nvidia.com (it starts with "nvapi-").
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Tool-calling support is verified in the G0 smoke test; change if it fails.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# MCP servers
GITHUB_PAT=            # fine-grained token, public repositories read-only
TAVILY_API_KEY=
CONTEXT7_API_KEY=

# Request triage classifier (D18). Jev is TypeSafe AI's System One model; Nemotron above is the fallback.
TYPESAFE_API_KEY=     # read by langchain-typesafe (TypeSafeClassifier)
TRIAGE_BACKEND=jev    # jev | nemotron

# Google Cloud (not secret)
GCP_PROJECT_ID=
GCP_REGION=us-west1
